{
  "name": "loyalty-interchange-protocol",
  "version": "0.2.0",
  "private": true,
  "description": "An open interoperability protocol for loyalty, starting with foodservice.",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:ts && npm run build:admin",
    "build:ts": "tsc -b",
    "build:admin": "npm run build --workspace @loyalty-interchange/admin",
    "cloud": "npm run build --workspace @loyalty-interchange/cloud && node apps/cloud/dist/cli.js",
    "cloud:dev": "tsx apps/cloud/src/cli.ts",
    "cloud:migrate": "tsx apps/cloud/src/migrate-cli.ts",
    "cloud:operator": "tsx apps/cloud/src/operator-cli.ts",
    "cloud:provision": "tsx apps/cloud/src/tenant-onboarding-cli.ts",
    "cloud:restore-verify": "tsx apps/cloud/src/restore-verification-cli.ts",
    "cloud:deployment-verify": "tsx apps/cloud/src/deployment-verification-cli.ts",
    "clean": "tsc -b --clean && rm -rf coverage spec/schemas",
    "conformance": "vitest run tests/conformance",
    "docs:check": "tsx scripts/check-docs-mirror.ts",
    "launch:check": "tsx scripts/check-launch-surface.ts",
    "dev": "tsx packages/server/src/cli.ts",
    "example:sdk": "tsx examples/typescript/full-lifecycle.ts",
    "example:bff": "tsx examples/typescript/ordering-bff.ts",
    "generate": "tsx scripts/generate-spec.ts && tsx scripts/generate-sdk.ts",
    "lip": "tsx packages/cli/src/cli.ts",
    "mcp": "tsx packages/mcp/src/server.ts",
    "quickstart": "npm run build:admin && tsx packages/cli/src/cli.ts quickstart",
    "release:evidence": "tsx scripts/prepare-release-evidence.ts",
    "release:manifest": "tsx scripts/generate-release-manifest.ts",
    "release:manifest:check": "tsx scripts/check-release-manifest.ts",
    "serve": "npm run build:admin && tsx packages/cli/src/cli.ts serve",
    "spec:check": "npm run generate && git diff --exit-code -- spec/schemas spec/openapi.yaml packages/sdk/src/generated/client.ts",
    "start": "npm run quickstart",
    "test": "vitest run",
    "test:examples": "tsx scripts/test-examples.ts",
    "test:packages": "tsx scripts/verify-packages.ts",
    "test:visual": "node scripts/verify-rendered-surfaces.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false && npm run typecheck --workspace @loyalty-interchange/admin",
    "verify": "npm run generate && npm run typecheck && npm run test:coverage && npm run test:examples && npm run build && npm run test:packages && npm run docs:check && npm run launch:check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
