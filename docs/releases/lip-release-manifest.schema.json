{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty-interchange.org/schema/releases/lip-release-manifest-v1.json",
  "title": "LIP release manifest v1",
  "description": "Structural JSON Schema for LIP release manifests. Consumers MUST also run the LIP release manifest semantic validator so cross-field evidence bindings, including image.reference ending with image.digest, are enforced.",
  "$comment": "Schema validation alone is not sufficient for the complete release manifest contract; run the semantic validator in scripts/check-release-manifest.ts after JSON Schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "protocol",
    "packages",
    "image",
    "database",
    "dependencies",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "openapiSha256"],
      "properties": {
        "version": { "const": "1.0" },
        "profile": { "const": "foodservice/1.0" },
        "openapiSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@loyalty-interchange/[a-z0-9-]+$"
          },
          "version": { "$ref": "#/$defs/semver" },
          "integrity": { "$ref": "#/$defs/npmSri" }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/containsProtocolPackage" },
        { "$ref": "#/$defs/containsAdapterKitPackage" },
        { "$ref": "#/$defs/containsStoragePackage" },
        { "$ref": "#/$defs/containsReferencePackage" },
        { "$ref": "#/$defs/containsStorageSqlitePackage" },
        { "$ref": "#/$defs/containsStoragePostgresPackage" },
        { "$ref": "#/$defs/containsServerPackage" },
        { "$ref": "#/$defs/containsSdkPackage" },
        { "$ref": "#/$defs/containsIdentityPackage" },
        { "$ref": "#/$defs/containsCliPackage" },
        { "$ref": "#/$defs/containsMcpPackage" }
      ]
    },
    "image": {
      "type": "object",
      "description": "The semantic validator MUST verify that image.reference is pinned to image.digest.",
      "additionalProperties": false,
      "required": ["reference", "digest", "provenanceUrl"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenanceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationSetSha256", "connectionMode"],
      "properties": {
        "migrationSetSha256": { "$ref": "#/$defs/sha256Hex" },
        "connectionMode": { "const": "direct" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfileSha256",
        "auditReportSha256",
        "sbomSha256",
        "riskRegisterSha256",
        "toolchain",
        "findings"
      ],
      "properties": {
        "lockfileSha256": { "$ref": "#/$defs/sha256Hex" },
        "auditReportSha256": { "$ref": "#/$defs/sha256Hex" },
        "sbomSha256": { "$ref": "#/$defs/sha256Hex" },
        "riskRegisterSha256": { "$ref": "#/$defs/sha256Hex" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "npm"],
          "properties": {
            "node": { "$ref": "#/$defs/semver" },
            "npm": { "$ref": "#/$defs/semver" }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "moderate",
            "high",
            "critical",
            "unapprovedHigh",
            "unapprovedCritical"
          ],
          "properties": {
            "moderate": { "$ref": "#/$defs/nonNegativeInteger" },
            "high": { "$ref": "#/$defs/nonNegativeInteger" },
            "critical": { "$ref": "#/$defs/nonNegativeInteger" },
            "unapprovedHigh": { "const": 0 },
            "unapprovedCritical": { "const": 0 }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runUrl", "conformanceReportSha256"],
      "properties": {
        "runUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "conformanceReportSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "npmSri": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
    },
    "containsProtocolPackage": {
      "contains": { "$ref": "#/$defs/protocolPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsStoragePackage": {
      "contains": { "$ref": "#/$defs/storagePackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsAdapterKitPackage": {
      "contains": { "$ref": "#/$defs/adapterKitPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsReferencePackage": {
      "contains": { "$ref": "#/$defs/referencePackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsStorageSqlitePackage": {
      "contains": { "$ref": "#/$defs/storageSqlitePackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsStoragePostgresPackage": {
      "contains": { "$ref": "#/$defs/storagePostgresPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsServerPackage": {
      "contains": { "$ref": "#/$defs/serverPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsSdkPackage": {
      "contains": { "$ref": "#/$defs/sdkPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsIdentityPackage": {
      "contains": { "$ref": "#/$defs/identityPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsCliPackage": {
      "contains": { "$ref": "#/$defs/cliPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "containsMcpPackage": {
      "contains": { "$ref": "#/$defs/mcpPackage" },
      "minContains": 1,
      "maxContains": 1
    },
    "protocolPackage": { "$ref": "#/$defs/packageNamedProtocol" },
    "adapterKitPackage": { "$ref": "#/$defs/packageNamedAdapterKit" },
    "storagePackage": { "$ref": "#/$defs/packageNamedStorage" },
    "referencePackage": { "$ref": "#/$defs/packageNamedReference" },
    "storageSqlitePackage": { "$ref": "#/$defs/packageNamedStorageSqlite" },
    "storagePostgresPackage": { "$ref": "#/$defs/packageNamedStoragePostgres" },
    "serverPackage": { "$ref": "#/$defs/packageNamedServer" },
    "sdkPackage": { "$ref": "#/$defs/packageNamedSdk" },
    "identityPackage": { "$ref": "#/$defs/packageNamedIdentity" },
    "cliPackage": { "$ref": "#/$defs/packageNamedCli" },
    "mcpPackage": { "$ref": "#/$defs/packageNamedMcp" },
    "packageNamedProtocol": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/protocol" } }
    },
    "packageNamedAdapterKit": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/adapter-kit" } }
    },
    "packageNamedStorage": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/storage" } }
    },
    "packageNamedReference": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/reference" } }
    },
    "packageNamedStorageSqlite": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/storage-sqlite" } }
    },
    "packageNamedStoragePostgres": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/storage-postgres" } }
    },
    "packageNamedServer": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/server" } }
    },
    "packageNamedSdk": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/sdk" } }
    },
    "packageNamedIdentity": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/identity" } }
    },
    "packageNamedCli": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/cli" } }
    },
    "packageNamedMcp": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "const": "@loyalty-interchange/mcp" } }
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
