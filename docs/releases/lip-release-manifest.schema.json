{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty-interchange.org/schema/releases/lip-release-manifest-v1.json",
  "title": "LIP release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "protocol",
    "packages",
    "image",
    "database",
    "dependencies",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "openapiSha256"],
      "properties": {
        "version": { "const": "1.0" },
        "profile": { "const": "foodservice/1.0" },
        "openapiSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@loyalty-interchange/[a-z0-9-]+$"
          },
          "version": { "$ref": "#/$defs/semver" },
          "integrity": { "$ref": "#/$defs/npmSri" }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "provenanceUrl"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenanceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationSetSha256", "connectionMode"],
      "properties": {
        "migrationSetSha256": { "$ref": "#/$defs/sha256Hex" },
        "connectionMode": { "const": "direct" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfileSha256",
        "auditReportSha256",
        "sbomSha256",
        "riskRegisterSha256",
        "toolchain",
        "findings"
      ],
      "properties": {
        "lockfileSha256": { "$ref": "#/$defs/sha256Hex" },
        "auditReportSha256": { "$ref": "#/$defs/sha256Hex" },
        "sbomSha256": { "$ref": "#/$defs/sha256Hex" },
        "riskRegisterSha256": { "$ref": "#/$defs/sha256Hex" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "npm"],
          "properties": {
            "node": { "$ref": "#/$defs/semver" },
            "npm": { "$ref": "#/$defs/semver" }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "moderate",
            "high",
            "critical",
            "unapprovedHigh",
            "unapprovedCritical"
          ],
          "properties": {
            "moderate": { "$ref": "#/$defs/nonNegativeInteger" },
            "high": { "$ref": "#/$defs/nonNegativeInteger" },
            "critical": { "$ref": "#/$defs/nonNegativeInteger" },
            "unapprovedHigh": { "const": 0 },
            "unapprovedCritical": { "const": 0 }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runUrl", "conformanceReportSha256"],
      "properties": {
        "runUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "conformanceReportSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "npmSri": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
