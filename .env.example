# Copy to .env and adjust. Every value below is a local-development default —
# never commit a real credential to this file.
#
# Nothing in this repo loads .env implicitly. Export it yourself:
#   cp .env.example .env && set -a && . ./.env && set +a
#
# --- Reference platform (packages/server, `npm run dev`) ---------------------

# Bearer token accepted by the reference platform. The quickstart docs and the
# TypeScript examples default to this literal value.
LIP_API_KEY=lip-dev-key

# SQLite state path. Ignored when LIP_DATABASE_URL is set.
LIP_DATABASE_PATH=.lip/reference.db

# Set to run the reference platform on PostgreSQL instead of SQLite. When set,
# LIP_TENANT_ID selects the tenant schema. Session leases require a direct
# endpoint; `-pooler` and `pgbouncer=true` URLs are rejected before connecting.
# See docs/postgres.md.
# LIP_DATABASE_URL=postgres://lip:lip@127.0.0.1:5432/lip
# LIP_TENANT_ID=

# Seed the demo program on boot. Set to false for an empty platform.
LIP_SEED_DEMO=true

# Set to true to wipe and recreate state on boot. Destructive.
# LIP_RESET=false

# JSON request logs. Set to false for human-readable output.
LIP_STRUCTURED_LOGS=true

# Refuse all writes and answer mutations with 503. See docs/reference-platform.md.
# LIP_WRITE_FREEZE=false

# Optional self-host heartbeat. Disabled by default. When enabled, the runtime
# sends at most one pseudonymous, allowlisted heartbeat per 24 hours to the
# explicit HTTPS endpoint. See docs/telemetry.md for the exact payload.
LIP_TELEMETRY_ENABLED=false
# LIP_TELEMETRY_ENDPOINT=https://telemetry.example.test/v1/heartbeat

HOST=127.0.0.1
PORT=3210

# Base URL used by the SDK examples and the MCP server.
LIP_BASE_URL=http://127.0.0.1:3210

# HMAC signing secret for outbound webhooks. Generate your own:
#   node -e "console.log('whsec_' + require('crypto').randomBytes(16).toString('hex'))"
LIP_WEBHOOK_SECRET=
# LIP_WEBHOOK_URL=http://127.0.0.1:4000/hooks
# Required only for a loopback/private receiver in local development.
# LIP_ALLOW_PRIVATE_WEBHOOK_NETWORKS=true

# --- Reference guest wallet (apps/wallet, `npm run wallet:dev`) --------------

WALLET_HOST=127.0.0.1
WALLET_PORT=3230
WALLET_PUBLIC_BASE_URL=http://127.0.0.1:3230
WALLET_CLOUD_BASE_URL=http://127.0.0.1:3220
WALLET_TENANT_ID=demo-foodservice
WALLET_OIDC_PROVIDER_ID=primary

# Production wallet login uses OIDC Authorization Code + PKCE. The optional
# client secret stays in the BFF and is never returned to the browser.
# WALLET_OIDC_ISSUER=https://identity.example.com
# WALLET_OIDC_CLIENT_ID=reference-wallet
# WALLET_OIDC_CLIENT_SECRET=

# Synthetic preview mode never calls the customer API. Disable it whenever
# OIDC is configured for a real deployment.
WALLET_DEMO=true

# --- Cloud control plane (apps/cloud, `npm run cloud:dev`) -------------------
# Requires PostgreSQL. `docker compose up -d postgres` provides one.

LIP_CLOUD_DATABASE_URL=postgres://lip:lip@127.0.0.1:5432/lip_cloud
LIP_CLOUD_DATA_PLANE_DATABASE_URL=postgres://lip:lip@127.0.0.1:5432/lip_dataplane
# Managed deployments require both variables and direct, unpooled endpoints.
# Sandbox and production must use independent Neon projects/databases/roles.

LIP_CLOUD_HOST=127.0.0.1
LIP_CLOUD_PORT=3220

# DEPRECATED. The shared key bootstraps the FIRST operator and
# nothing else — it cannot authenticate onboarding or rotation requests.
# Must be at least 16 characters. After bootstrapping with
#   npm run cloud:operator -- create
# move every caller to LIP_CLOUD_OPERATOR_KEY (lip_ok_...) and set
# LIP_CLOUD_SHARED_KEY_DISABLED=true. Production must set it to true.
LIP_CLOUD_API_KEY=
LIP_CLOUD_SHARED_KEY_DISABLED=false

# Per-operator API key issued by `npm run cloud:operator -- create`.
# LIP_CLOUD_OPERATOR_KEY=lip_ok_...

# OIDC is the supported production auth path. Issuer and audience must be set
# together; bootstrap subjects are the identities allowed to create the first
# operator when no operator exists yet.
# LIP_CLOUD_OIDC_ISSUER=
# LIP_CLOUD_OIDC_AUDIENCE=
# LIP_CLOUD_OIDC_JWKS_URI=
# LIP_CLOUD_BOOTSTRAP_SUBJECTS=
# LIP_CLOUD_BOOTSTRAP_SUBJECT is accepted as a singular alias for the above.

LIP_CLOUD_REGIONS=us-east-1
LIP_CLOUD_DEFAULT_PLAN=free
LIP_CLOUD_DATA_DIR=.lip-cloud
LIP_CLOUD_ALLOWED_ORIGINS=http://localhost:3000
# LIP_CLOUD_PROGRAM_DIR=
# LIP_CLOUD_DATA_PLANE_HOST=
# LIP_CLOUD_DATA_PLANE_PUBLIC_HOST=
# LIP_CLOUD_DATA_PLANE_BASE_PORT=

# Remote attach accepts only public HTTPS destinations by default. Enable this
# only while attaching a loopback/private data plane in local development.
# LIP_CLOUD_ALLOW_PRIVATE_ATTACH_NETWORKS=true
# Restore rehearsal (direct source + distinct direct restored-branch URLs).
# LIP_BACKUP_SOURCE_DATABASE_URL=
# LIP_BACKUP_RESTORE_DATABASE_URL=

# --- Tests -------------------------------------------------------------------

# The PostgreSQL storage suite SKIPS when this is unset. CI sets the same value.
LIP_TEST_POSTGRES_URL=postgres://lip:lip@127.0.0.1:5432/lip_test
